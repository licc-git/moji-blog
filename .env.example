# ===== Flask 基础配置 =====
# 运行模式：development / production
FLASK_ENV=development
# 用于会话与 CSRF 加密签名，生产环境务必替换为强随机值
SECRET_KEY=please-change-this-to-a-long-random-secret-string

# ===== MySQL 数据库连接 =====
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://bloguser:Blog!Pass2026@localhost:3306/my_blog?charset=utf8mb4

# ===== 单用户管理员账户 =====
# 首次运行 `flask init-db` 或脚本时会用这些值创建管理员
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@123.com
ADMIN_PASSWORD=admin123

# ===== 文件上传 =====
# 上传根目录（相对项目根目录）
UPLOAD_FOLDER=uploads
# 单文件最大体积（字节），默认 16MB
MAX_CONTENT_LENGTH=16777216

# ===== AI 大模型配置 =====
# 选择当前使用的服务商：deepseek / glm
AI_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM（OpenAI 兼容接口）
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
